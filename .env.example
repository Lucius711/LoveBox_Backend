# =====================================================================
# Love Box — Environment Variables Example
# Copy to .env and fill in actual values (never commit .env)
# =====================================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lovebox_db
DB_USERNAME=lovebox_user
DB_PASSWORD=changeme

# --- JWT ---
JWT_SECRET=your-256-bit-secret-key-here-minimum-32-chars

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Gemini AI ---
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# --- Payment (VietQR) ---
BANK_ACCOUNT=your-bank-account-number
BANK_NAME=MB
ACCOUNT_NAME=NGUYEN VAN A

# --- Email Notification (Resend) ---
# Đăng ký tại: https://resend.com → Settings → API Keys
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=your-email@gmail.com

# --- Server ---
SERVER_PORT=8080

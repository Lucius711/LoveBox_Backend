# =====================================================================
# Lentique — Environment Variables Example
# Copy to .env and fill in actual values (never commit .env)
# =====================================================================

# --- Database (tạo DB mới: CREATE DATABASE lovebox_db;) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lovebox_db
DB_USERNAME=lovebox
DB_PASSWORD=changeme

# --- JWT ---
JWT_SECRET=your-256-bit-secret-key-here-minimum-32-chars

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Quyền admin: email Google đăng nhập sẽ tự có role ADMIN (cách nhau dấu phẩy) ---
ADMIN_EMAILS=you@gmail.com

# --- Gemini AI (bóc tách từ khoá cho trợ lý tìm đồ; để trống → so khớp cục bộ) ---
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# --- PayOS (QR chuyển khoản — app ngân hàng / MoMo quét được) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/checkout/success
PAYOS_CANCEL_URL=http://localhost:5173/checkout/success

# --- Email thông báo cho chủ đồ (Resend) — FROM_EMAIL phải thuộc domain đã verify trên Resend ---
RESEND_API_KEY=re_...
FROM_EMAIL=Lentique <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:5173
# Domain FE được phép gọi API (CORS), cách nhau dấu phẩy
CORS_ORIGINS=http://localhost:5173,https://lentique.shop,https://www.lentique.shop

# --- Cloudflare R2 (ảnh sản phẩm) ---
# Dashboard → R2 → Manage API tokens → quyền Object Read & Write cho bucket
# Bucket → Settings → Public access: bật r2.dev hoặc gắn custom domain → điền vào R2_PUBLIC_URL
# Bucket → Settings → CORS policy (trình duyệt upload thẳng lên R2):
#   [{"AllowedOrigins":["http://localhost:5173","https://your-domain"],"AllowedMethods":["PUT"],"AllowedHeaders":["Content-Type"],"MaxAgeSeconds":3600}]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lovebox
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Server ---
SERVER_PORT=8080
